rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboards/{board}/scores/{playerId} {
      function signedIn() {
        // hack: 'endless' is the Hardcore board's key, kept until the client,
        // rules & deploy are renamed together in a later change
        return request.auth != null && board in ['normal', 'endless'];
      }
      function validScore() {
        return request.resource.data.keys().hasAll(['displayName', 'score'])
          && request.resource.data.keys().hasOnly(['displayName', 'score'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 24
          && request.resource.data.score is int
          && request.resource.data.score >= 0;
      }
      allow get: if signedIn() && request.auth.uid == playerId;
      allow list: if signedIn() && request.query.limit != null
        && request.query.limit <= 10;
      allow create: if signedIn() && request.auth.uid == playerId
        && validScore();
      allow update: if signedIn() && request.auth.uid == playerId
        && validScore()
        && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }
  }
}
